rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function supportStaff() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/accountRoles/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/accountRoles/$(request.auth.uid)).data.level >= 5;
    }

    function businessOwner(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        firestore.exists(/databases/(default)/documents/accountRoles/$(userId)) &&
        firestore.get(/databases/(default)/documents/accountRoles/$(userId)).data.role == 'business' &&
        firestore.get(/databases/(default)/documents/accountRoles/$(userId)).data.level == 2;
    }

    match /businessLogos/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if businessOwner(userId) &&
        fileName.matches('logo-[0-9]+\\.png') &&
        request.resource.size > 0 &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/png';
      allow delete: if businessOwner(userId);
    }

    match /bugReports/{userId}/{reportId}/screenshot {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.size > 0 &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') &&
        firestore.exists(/databases/(default)/documents/bugReports/$(reportId)) &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.userId == userId &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.status == 'open' &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.screenshotPath ==
          'bugReports/' + userId + '/' + reportId + '/screenshot' &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.screenshotContentType ==
          request.resource.contentType &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.screenshotSize ==
          request.resource.size;
      allow read: if signedIn() &&
        (request.auth.uid == userId || supportStaff());
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
