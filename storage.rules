rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Role-based paths use the official Storage Rules to Firestore bridge.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function supportStaff() {
      // Two distinct bridge documents: authoritative role and current ban.
      // Own screenshot access below does not require this staff exception.
      let rolePath = /databases/(default)/documents/accountRoles/$(request.auth.uid);
      let banPath = /databases/(default)/documents/bans/$(request.auth.uid);
      return signedIn() &&
        firestore.exists(rolePath) &&
        firestore.get(rolePath).data.get('accountStatus', 'active') != 'deleted' &&
        firestore.get(rolePath).data.level is int &&
        firestore.get(rolePath).data.level >= 5 &&
        (!firestore.exists(banPath) ||
          (firestore.get(banPath).data.expiresAt is timestamp &&
            firestore.get(banPath).data.expiresAt <= request.time));
    }

    // Local identity prototype. One distinct Firestore document for a logo read.
    function visibleLogoOwner(userId) {
      return !firestore.exists(/databases/(default)/documents/publicProfiles/$(userId)) ||
        firestore.get(/databases/(default)/documents/publicProfiles/$(userId)).data.get('accountStatus', 'active') != 'deleted';
    }

    function businessOwner(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        visibleLogoOwner(userId) &&
        firestore.exists(/databases/(default)/documents/accountRoles/$(userId)) &&
        firestore.get(/databases/(default)/documents/accountRoles/$(userId)).data.get('accountStatus', 'active') != 'deleted' &&
        firestore.get(/databases/(default)/documents/accountRoles/$(userId)).data.role == 'business' &&
        firestore.get(/databases/(default)/documents/accountRoles/$(userId)).data.level == 2;
    }

    match /businessLogos/{userId}/{fileName} {
      allow read: if signedIn() && visibleLogoOwner(userId);
      allow create, update: if businessOwner(userId) &&
        fileName.matches('logo-[0-9]+\\.png') &&
        request.resource.size > 0 &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/png';
      allow delete: if businessOwner(userId);
    }

    match /bugReports/{userId}/{reportId}/screenshot {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.size > 0 &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') &&
        firestore.exists(/databases/(default)/documents/bugReports/$(reportId)) &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.userId == userId &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.status == 'open' &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.screenshotPath ==
          'bugReports/' + userId + '/' + reportId + '/screenshot' &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.screenshotContentType ==
          request.resource.contentType &&
        firestore.get(/databases/(default)/documents/bugReports/$(reportId)).data.screenshotSize ==
          request.resource.size;
      allow read: if signedIn() &&
        (request.auth.uid == userId || supportStaff());
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
