{
  "name": "shoutout-dev-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "firebase": "firebase",
    "reconcile:data": "node reconcile_counters.mjs",
    "set:role": "node set_role.mjs",
    "activate:business": "node activate_business_application.mjs",
    "test:tools": "node --test business_activation.test.mjs moderation_seed.test.mjs web_environment.test.mjs feed_prototype.test.mjs",
    "prototype:feed": "node feed_prototype.mjs",
    "backfill:geography": "node backfill_shout_geography.mjs",
    "backfill:public-profiles": "node backfill_public_profiles.mjs",
    "reset:integration": "node reset_integration_scenario.mjs",
    "inspect:integration": "node inspect_integration_scenario.mjs",
    "verify:moderator-client": "node verify_moderator_client_access.mjs",
    "seed:moderation-queue": "node seed_moderation_queue.mjs",
    "test:rules": "firebase emulators:exec --config ../firebase.rules-test.json --only firestore --project shoutout-rules-test \"node --test --test-concurrency=1 rules/firestore.rules.test.mjs ../functions/create_shout.integration.test.js ../functions/create_comment.integration.test.js ../functions/create_private_reply.integration.test.js ../functions/toggle_shout_reaction.integration.test.js ../functions/toggle_comment_reaction.integration.test.js ../functions/toggle_shout_save.integration.test.js ../functions/create_content_report.integration.test.js ../functions/delete_comment.integration.test.js ../functions/operation_retention.integration.test.js ../functions/cleanup_operation_receipts.integration.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "15.31.0"
  }
}
