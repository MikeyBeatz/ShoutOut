rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedIdentity() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }

    function hasRoleLevel(minimumLevel) {
      let rolePath =
        /databases/$(database)/documents/accountRoles/$(request.auth.uid);
      return signedIn() &&
        (
          (
            exists(rolePath) &&
            get(rolePath).data.level is int &&
            get(rolePath).data.level >= minimumLevel
          ) ||
          (
            minimumLevel <= 3 &&
            exists(
              /databases/$(database)/documents/moderators/$(request.auth.uid)
            )
          )
        );
    }

    function isModerator() {
      return hasRoleLevel(3);
    }

    function isBusinessAccount() {
      let rolePath =
        /databases/$(database)/documents/accountRoles/$(request.auth.uid);
      return signedIn() &&
        exists(rolePath) &&
        get(rolePath).data.role == 'business' &&
        get(rolePath).data.level == 2;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAcceptedLegal() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/legal/acceptance_2026_07_25
        );
    }

    function hasActiveBan() {
      let banPath =
        /databases/$(database)/documents/bans/$(request.auth.uid);
      return signedIn() &&
        exists(banPath) &&
        (
          get(banPath).data.expiresAt == null ||
          get(banPath).data.expiresAt > request.time
        );
    }

    function deletionPending() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)
        );
    }

    function eligibleUser() {
      return verifiedIdentity() &&
        hasProfile() &&
        hasAcceptedLegal() &&
        !hasActiveBan() &&
        !deletionPending();
    }

    function eligibleModerator() {
      return eligibleUser() && isModerator();
    }

    function eligibleSeniorModerator() {
      return eligibleUser() && hasRoleLevel(4);
    }

    function eligibleAdministrator() {
      return eligibleUser() && hasRoleLevel(5);
    }

    function hasActiveContentRestriction() {
      let restrictionPath =
        /databases/$(database)/documents/contentRestrictions/$(request.auth.uid);
      return signedIn() &&
        exists(restrictionPath) &&
        get(restrictionPath).data.expiresAt > request.time;
    }

    function canCreateContent() {
      return eligibleUser() && !hasActiveContentRestriction();
    }

    function validSanctionLink(userId, type, sanctionId) {
      let sanctionPath =
        /databases/$(database)/documents/sanctions/$(sanctionId);
      return sanctionId is string &&
        existsAfter(sanctionPath) &&
        getAfter(sanctionPath).data.userId == userId &&
        getAfter(sanctionPath).data.type == type &&
        getAfter(sanctionPath).data.moderatorId == request.auth.uid &&
        getAfter(sanctionPath).data.createdAt == request.time;
    }

    function targetRoleLevel(userId) {
      let rolePath = /databases/$(database)/documents/accountRoles/$(userId);
      return exists(rolePath) && get(rolePath).data.level is int
        ? get(rolePath).data.level
        : exists(/databases/$(database)/documents/moderators/$(userId))
          ? 3
          : 1;
    }

    function canSanctionUser(userId) {
      return userId != request.auth.uid &&
        targetRoleLevel(userId) < targetRoleLevel(request.auth.uid);
    }

    function moderationScopeAllowsShout(shoutId) {
      let rolePath =
        /databases/$(database)/documents/accountRoles/$(request.auth.uid);
      let shoutPath = /databases/$(database)/documents/shouts/$(shoutId);
      let role = exists(rolePath) ? get(rolePath).data : {};
      let scope = role.get('moderationScope', {});
      let geography = exists(shoutPath)
        ? get(shoutPath).data.get('geography', {})
        : {};
      return role.get('level', 0) >= 5 ||
        !('moderationScope' in role) ||
        scope.get('global', false) == true ||
        geography.get('countryCode', '') in scope.get('countries', []) ||
        geography.get('subdivisionCode', '') in
          scope.get('subdivisions', []);
    }

    function moderationScopeAllowsSanction() {
      return request.resource.data.sourceContentType == 'shout'
        ? moderationScopeAllowsShout(request.resource.data.sourceContentId)
        : moderationScopeAllowsShout(
            request.resource.data.contentSnapshot.get('shoutId', '')
          );
    }

    function canRevokeSanction(sanctionId) {
      let sanctionPath =
        /databases/$(database)/documents/sanctions/$(sanctionId);
      return eligibleModerator() &&
        exists(sanctionPath) &&
        canSanctionUser(get(sanctionPath).data.userId) &&
        (
          eligibleSeniorModerator() ||
          (
            get(sanctionPath).data.moderatorId == request.auth.uid &&
            get(sanctionPath).data.permanent == false
          )
        );
    }

    function validRevocation(sanctionId, userId) {
      let revocationPath =
        /databases/$(database)/documents/sanctionRevocations/$(sanctionId);
      return existsAfter(revocationPath) &&
        getAfter(revocationPath).data.userId == userId &&
        getAfter(revocationPath).data.sanctionId == sanctionId &&
        getAfter(revocationPath).data.revokedBy == request.auth.uid &&
        getAfter(revocationPath).data.createdAt == request.time;
    }

    function limited(maximum) {
      return request.query.limit != null &&
        request.query.limit > 0 &&
        request.query.limit <= maximum;
    }

    function validAvatarId(avatarId) {
      return avatarId in [
        'fox', 'owl', 'otter', 'raccoon', 'robot', 'astronaut', 'cactus',
        'mushroom', 'moon', 'comet', 'cat', 'dragon', 'mountain',
        'lightning', 'controller', 'octopus', 'bear', 'panda', 'rabbit',
        'penguin', 'frog', 'dog', 'hedgehog', 'parrot'
      ];
    }

    function validAvatarColor(colorId) {
      return colorId in [
        'teal', 'navy', 'aqua', 'purple', 'coral', 'gold', 'green', 'rose',
        'sky', 'indigo', 'pink', 'orange', 'lime', 'mint', 'brown', 'slate'
      ];
    }

    function validAvatarStyle(data) {
      return validAvatarId(data.avatarId) &&
        validAvatarColor(data.avatarBackgroundStart) &&
        validAvatarColor(data.avatarBackgroundEnd) &&
        data.avatarGradientDirection in ['horizontal', 'diagonal', 'vertical'];
    }

    function validPublicProfile(userId, data) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return data.keys().hasOnly([
          'nickname', 'avatarId', 'avatarBackgroundStart',
          'avatarBackgroundEnd', 'avatarGradientDirection'
        ]) &&
        data.keys().hasAll([
          'nickname', 'avatarId', 'avatarBackgroundStart',
          'avatarBackgroundEnd', 'avatarGradientDirection'
        ]) &&
        validAvatarStyle(data) &&
        existsAfter(userPath) &&
        data.nickname == getAfter(userPath).data.nickname &&
        data.avatarId == getAfter(userPath).data.avatarId &&
        data.avatarBackgroundStart ==
          getAfter(userPath).data.avatarBackgroundStart &&
        data.avatarBackgroundEnd ==
          getAfter(userPath).data.avatarBackgroundEnd &&
        data.avatarGradientDirection ==
          getAfter(userPath).data.avatarGradientDirection;
    }

    function validNickname(nickname, nicknameLower) {
      return nickname is string &&
        nickname.size() >= 3 &&
        nickname.size() <= 24 &&
        nickname.matches('^[a-zA-Z0-9]+([-_][a-zA-Z0-9]+)*$') &&
        nicknameLower is string &&
        nicknameLower.size() >= 3 &&
        nicknameLower.size() <= 24 &&
        nicknameLower.matches('^[a-z0-9]+([-_][a-z0-9]+)*$');
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'nickname',
          'nicknameLower',
          'createdAt',
          'nicknameChangedAt',
          'nicknameChangeCount',
          'emailVerified',
          'language',
          'themeMode',
          'showOnboardingHelp',
          'avatarId',
          'avatarBackgroundStart',
          'avatarBackgroundEnd',
          'avatarGradientDirection'
        ]) &&
        request.resource.data.keys().hasAll([
          'nickname',
          'nicknameLower',
          'createdAt',
          'nicknameChangedAt',
          'nicknameChangeCount',
          'emailVerified',
          'language',
          'themeMode',
          'showOnboardingHelp',
          'avatarId',
          'avatarBackgroundStart',
          'avatarBackgroundEnd',
          'avatarGradientDirection'
        ]) &&
        validNickname(
          request.resource.data.nickname,
          request.resource.data.nicknameLower
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.nicknameChangedAt == request.time &&
        request.resource.data.nicknameChangeCount == 0 &&
        request.resource.data.emailVerified ==
          request.auth.token.email_verified &&
        request.resource.data.language in ['cs', 'en', 'de', 'pl', 'sk', 'uk', 'vi'] &&
        request.resource.data.themeMode in ['system', 'light', 'dark'] &&
        request.resource.data.showOnboardingHelp == true &&
        validAvatarStyle(request.resource.data);
    }

    function validNicknameChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'nickname',
            'nicknameLower',
            'nicknameChangedAt',
            'nicknameChangeCount'
          ]) &&
        validNickname(
          request.resource.data.nickname,
          request.resource.data.nicknameLower
        ) &&
        request.resource.data.nicknameChangedAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ) &&
        getAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ).data.uid == request.auth.uid &&
        (
          (!resource.data.keys().hasAll(['nicknameChangeCount']) &&
            request.resource.data.nicknameChangeCount == 1) ||
          (resource.data.keys().hasAll(['nicknameChangeCount']) &&
            request.resource.data.nicknameChangeCount ==
              resource.data.nicknameChangeCount + 1)
        ) &&
        (
          !resource.data.keys().hasAll(['nicknameChangeCount']) ||
          resource.data.nicknameChangeCount == 0 ||
          request.time >=
            resource.data.nicknameChangedAt + duration.value(30, 'd')
        );
    }

    function rateCooldown(action) {
      return action == 'shout'
        ? (isBusinessAccount()
          ? duration.value(1, 's')
          : duration.value(2, 'm'))
        : action == 'report'
          ? duration.value(1, 'm')
          : action in ['comment', 'privateReply']
            ? duration.value(10, 's')
            : duration.value(1, 's');
    }

    function rateWindow(action) {
      return action in ['shout', 'report']
        ? duration.value(1, 'd')
        : duration.value(1, 'h');
    }

    function rateMaximum(action) {
      return action == 'shout'
        ? (isBusinessAccount() ? 500 : 50)
        : action == 'report'
          ? 20
          : action in ['comment', 'privateReply']
            ? 60
            : 120;
    }

    function validRateDocument(action) {
      return action in [
          'shout', 'comment', 'privateReply', 'report', 'interaction', 'delete'
        ] &&
        request.resource.data.keys().hasOnly([
          'lastAt', 'lastEventId', 'windowStartedAt', 'count'
        ]) &&
        request.resource.data.keys().hasAll([
          'lastAt', 'lastEventId', 'windowStartedAt', 'count'
        ]) &&
        request.resource.data.lastAt == request.time &&
        request.resource.data.lastEventId is string &&
        request.resource.data.lastEventId.size() >= 1 &&
        request.resource.data.lastEventId.size() <= 500 &&
        request.resource.data.windowStartedAt is timestamp &&
        request.resource.data.count is int &&
        request.resource.data.count >= 1 &&
        request.resource.data.count <= rateMaximum(action);
    }

    function validRateCreate(action) {
      return validRateDocument(action) &&
        request.resource.data.windowStartedAt == request.time &&
        request.resource.data.count == 1;
    }

    function validRateUpdate(action) {
      return validRateDocument(action) &&
        resource.data.lastAt is timestamp &&
        resource.data.windowStartedAt is timestamp &&
        resource.data.count is int &&
        request.time >= resource.data.lastAt + rateCooldown(action) &&
        (
          (
            request.time <
              resource.data.windowStartedAt + rateWindow(action) &&
            request.resource.data.windowStartedAt ==
              resource.data.windowStartedAt &&
            request.resource.data.count == resource.data.count + 1
          ) ||
          (
            request.time >=
              resource.data.windowStartedAt + rateWindow(action) &&
            request.resource.data.windowStartedAt == request.time &&
            request.resource.data.count == 1
          )
        );
    }

    function consumedRate(action, eventId) {
      let ratePath =
        /databases/$(database)/documents/rateLimits/$(request.auth.uid)/actions/$(action);
      return existsAfter(ratePath) &&
        getAfter(ratePath).data.lastAt == request.time &&
        getAfter(ratePath).data.lastEventId == eventId;
    }

    function canonicalNickname(data) {
      return data.authorNickname ==
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nickname;
    }

    function validBusinessShout(data) {
      let businessPath =
        /databases/$(database)/documents/businessProfiles/$(request.auth.uid);
      let locationPath =
        /databases/$(database)/documents/businessProfiles/$(request.auth.uid)/locations/$(data.businessLocationId);
      let business = get(businessPath).data;
      let location = get(locationPath).data;
      return isBusinessAccount() &&
        data.businessLocationId is string &&
        exists(businessPath) &&
        exists(locationPath) &&
        business.status == 'active' &&
        location.active == true &&
        location.deleted == false &&
        location.geocodingStatus == 'verified' &&
        data.businessAuthorFormat == 'branch' &&
        data.authorNickname == location.displayName &&
        data.location == location.location &&
        data.geohash == location.geohash;
    }

    function activeShout(shoutId) {
      let shoutPath =
        /databases/$(database)/documents/shouts/$(shoutId);
      return exists(shoutPath) &&
        get(shoutPath).data.status == 'active' &&
        get(shoutPath).data.expiresAt > request.time;
    }

    match /moderators/{moderatorId} {
      allow get: if signedIn() && request.auth.uid == moderatorId;
      allow list, create, update, delete: if false;
    }

    match /accountRoles/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || eligibleModerator());
      allow list, create, update, delete: if false;
    }

    match /contentRestrictions/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isModerator());
      allow create, update: if eligibleModerator() &&
        request.resource.data.keys().hasOnly([
          'userId', 'reason', 'createdAt', 'expiresAt', 'moderatorId',
          'sanctionId'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'reason', 'createdAt', 'expiresAt', 'moderatorId',
          'sanctionId'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <=
          request.time + duration.value(90, 'd') &&
        (
          hasRoleLevel(4) ||
          request.resource.data.expiresAt <=
            request.time + duration.value(30, 'd')
        ) &&
        request.resource.data.moderatorId == request.auth.uid &&
        validSanctionLink(
          userId,
          'contentRestriction',
          request.resource.data.sanctionId
        );
      allow list: if false;
      allow delete: if eligibleModerator() &&
        validRevocation(resource.data.sanctionId, userId);
    }

    match /sanctions/{sanctionId} {
      allow get: if signedIn() &&
        (resource.data.userId == request.auth.uid || eligibleModerator());
      allow list: if eligibleModerator() && limited(50);
      allow create: if eligibleModerator() &&
        request.resource.data.keys().hasOnly([
          'userId', 'type', 'reason', 'createdAt', 'expiresAt', 'permanent',
          'moderatorId', 'status', 'sourceReportId', 'previousSanctionsCount',
          'purgeAt', 'sourceType', 'sourceContentType', 'sourceContentId',
          'contentSnapshot'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'type', 'reason', 'createdAt', 'expiresAt', 'permanent',
          'moderatorId', 'status', 'sourceReportId', 'previousSanctionsCount',
          'purgeAt', 'sourceType', 'sourceContentType', 'sourceContentId',
          'contentSnapshot'
        ]) &&
        request.resource.data.userId is string &&
        canSanctionUser(request.resource.data.userId) &&
        moderationScopeAllowsSanction() &&
        request.resource.data.type in [
          'warning', 'contentRestriction', 'accountBan'
        ] &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.moderatorId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.sourceReportId is string &&
        request.resource.data.sourceType in ['report', 'moderatorObservation'] &&
        request.resource.data.sourceContentType in [
          'shout', 'comment', 'privateReply'
        ] &&
        request.resource.data.sourceContentId is string &&
        request.resource.data.contentSnapshot is map &&
        request.resource.data.previousSanctionsCount is int &&
        request.resource.data.previousSanctionsCount >= 0 &&
        request.resource.data.purgeAt is timestamp &&
        request.resource.data.purgeAt > request.time &&
        (
          (
            request.resource.data.type == 'warning' &&
            request.resource.data.expiresAt == null &&
            request.resource.data.permanent == false
          ) ||
          (
            request.resource.data.type in [
              'contentRestriction', 'accountBan'
            ] &&
            (
              (
                request.resource.data.expiresAt is timestamp &&
                request.resource.data.expiresAt > request.time &&
                request.resource.data.expiresAt <=
                  request.time + duration.value(90, 'd') &&
                request.resource.data.permanent == false &&
                (
                  hasRoleLevel(4) ||
                  request.resource.data.expiresAt <=
                    request.time + duration.value(30, 'd')
                )
              ) ||
              (
                request.resource.data.type == 'accountBan' &&
                request.resource.data.expiresAt == null &&
                request.resource.data.permanent == true &&
                eligibleSeniorModerator()
              )
            )
          )
        );
      allow update, delete: if false;
    }

    match /sanctionRevocations/{sanctionId} {
      allow get: if signedIn() &&
        (resource.data.userId == request.auth.uid || eligibleModerator());
      allow list: if eligibleModerator() && limited(50);
      allow create: if canRevokeSanction(sanctionId) &&
        !exists(
          /databases/$(database)/documents/sanctionRevocations/$(sanctionId)
        ) &&
        request.resource.data.keys().hasOnly([
          'userId', 'sanctionId', 'originalType', 'reason', 'createdAt',
          'revokedBy', 'purgeAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'sanctionId', 'originalType', 'reason', 'createdAt',
          'revokedBy', 'purgeAt'
        ]) &&
        request.resource.data.userId ==
          get(
            /databases/$(database)/documents/sanctions/$(sanctionId)
          ).data.userId &&
        request.resource.data.sanctionId == sanctionId &&
        request.resource.data.originalType ==
          get(
            /databases/$(database)/documents/sanctions/$(sanctionId)
          ).data.type &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.revokedBy == request.auth.uid &&
        request.resource.data.purgeAt is timestamp &&
        request.resource.data.purgeAt > request.time;
      allow update, delete: if false;
    }

    match /bans/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isModerator());
      allow create, update: if eligibleModerator() &&
        request.resource.data.keys().hasOnly([
          'userId', 'reason', 'createdAt', 'expiresAt', 'moderatorId',
          'sanctionId'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'reason', 'createdAt', 'expiresAt', 'moderatorId',
          'sanctionId'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        (
          request.resource.data.expiresAt == null ||
          request.resource.data.expiresAt is timestamp
        ) &&
        request.resource.data.moderatorId == request.auth.uid &&
        validSanctionLink(
          userId,
          'accountBan',
          request.resource.data.sanctionId
        ) &&
        (
          request.resource.data.expiresAt != null ||
          eligibleSeniorModerator()
        );
      allow list: if false;
      allow delete: if eligibleModerator() &&
        validRevocation(resource.data.sanctionId, userId);
    }

    match /warnings/{warningId} {
      allow get: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          eligibleModerator()
        );
      allow list: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          eligibleModerator()
        ) &&
        limited(50);
      allow create: if eligibleModerator() &&
        request.resource.data.keys().hasOnly([
          'userId', 'reason', 'createdAt', 'moderatorId', 'sanctionId'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'reason', 'createdAt', 'moderatorId', 'sanctionId'
        ]) &&
        request.resource.data.userId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.moderatorId == request.auth.uid &&
        validSanctionLink(
          request.resource.data.userId,
          'warning',
          request.resource.data.sanctionId
        );
      allow update, delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isModerator());
      allow create: if verifiedIdentity() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'userId', 'email', 'requestedAt', 'retainUntil', 'status'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'email', 'requestedAt', 'retainUntil', 'status'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.requestedAt == request.time &&
        request.resource.data.retainUntil >=
          request.time + duration.value(59, 'd') &&
        request.resource.data.retainUntil <=
          request.time + duration.value(61, 'd') &&
        request.resource.data.status == 'pending';
      allow list, update, delete: if false;
    }

    match /businessApplications/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isModerator());
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.auth.token.email is string &&
        request.resource.data.keys().hasOnly([
          'userId',
          'countryCode',
          'registrationNumber',
          'submittedCompanyName',
          'submittedAddress',
          'submittedCity',
          'submittedPostalCode',
          'initialLocationName',
          'initialLocationAddress',
          'initialLocationCity',
          'initialLocationPostalCode',
          'initialLocationCountryCode',
          'initialLocation',
          'initialLocationGeohash',
          'initialLocationProviderPlaceId',
          'contactEmail',
          'status',
          'submittedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId',
          'countryCode',
          'registrationNumber',
          'submittedCompanyName',
          'submittedAddress',
          'submittedCity',
          'submittedPostalCode',
          'initialLocationName',
          'initialLocationAddress',
          'initialLocationCity',
          'initialLocationPostalCode',
          'initialLocationCountryCode',
          'initialLocation',
          'initialLocationGeohash',
          'initialLocationProviderPlaceId',
          'contactEmail',
          'status',
          'submittedAt'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.countryCode is string &&
        request.resource.data.countryCode.size() >= 2 &&
        request.resource.data.countryCode.size() <= 5 &&
        request.resource.data.countryCode.matches('^[A-Z]+$') &&
        request.resource.data.registrationNumber is string &&
        request.resource.data.registrationNumber.size() >= 3 &&
        request.resource.data.registrationNumber.size() <= 40 &&
        request.resource.data.submittedCompanyName is string &&
        request.resource.data.submittedCompanyName.size() >= 2 &&
        request.resource.data.submittedCompanyName.size() <= 160 &&
        request.resource.data.submittedAddress is string &&
        request.resource.data.submittedAddress.size() >= 3 &&
        request.resource.data.submittedAddress.size() <= 200 &&
        request.resource.data.submittedCity is string &&
        request.resource.data.submittedCity.size() >= 1 &&
        request.resource.data.submittedCity.size() <= 100 &&
        request.resource.data.submittedPostalCode is string &&
        request.resource.data.submittedPostalCode.size() >= 2 &&
        request.resource.data.submittedPostalCode.size() <= 20 &&
        request.resource.data.initialLocationName is string &&
        request.resource.data.initialLocationName.size() >= 1 &&
        request.resource.data.initialLocationName.size() <= 100 &&
        request.resource.data.initialLocationAddress is string &&
        request.resource.data.initialLocationAddress.size() >= 3 &&
        request.resource.data.initialLocationAddress.size() <= 200 &&
        request.resource.data.initialLocationCity is string &&
        request.resource.data.initialLocationCity.size() <= 100 &&
        request.resource.data.initialLocationPostalCode is string &&
        request.resource.data.initialLocationPostalCode.size() <= 20 &&
        request.resource.data.initialLocationCountryCode is string &&
        request.resource.data.initialLocationCountryCode.matches('^[A-Z]{2}$') &&
        request.resource.data.initialLocation is latlng &&
        request.resource.data.initialLocationGeohash is string &&
        request.resource.data.initialLocationGeohash.matches('^[0-9b-hj-km-np-z]{7}$') &&
        request.resource.data.initialLocationProviderPlaceId is string &&
        request.resource.data.initialLocationProviderPlaceId.size() >= 1 &&
        request.resource.data.initialLocationProviderPlaceId.size() <= 200 &&
        request.resource.data.contactEmail == request.auth.token.email &&
        request.resource.data.status == 'pending_email' &&
        request.resource.data.submittedAt == request.time;
      allow list, update, delete: if false;
    }

    match /businessProfiles/{userId} {
      allow get: if verifiedIdentity() &&
        (request.auth.uid == userId || isModerator());
      allow update: if eligibleUser() &&
        request.auth.uid == userId &&
        isBusinessAccount() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'registryAddress', 'billingCity',
          'billingPostalCode', 'billingEmail', 'updatedAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.registryAddress is string &&
        request.resource.data.registryAddress.size() >= 3 &&
        request.resource.data.registryAddress.size() <= 200 &&
        request.resource.data.billingCity is string &&
        request.resource.data.billingCity.size() <= 100 &&
        request.resource.data.billingPostalCode is string &&
        request.resource.data.billingPostalCode.size() <= 20 &&
        request.resource.data.billingEmail is string &&
        request.resource.data.billingEmail.size() <= 254 &&
        request.resource.data.updatedAt == request.time;
      allow list, create, delete: if false;

      match /locations/{locationId} {
        function validLocation() {
          return request.resource.data.keys().hasOnly([
              'displayName', 'address', 'active', 'deleted',
              'geocodingStatus', 'location', 'geohash', 'providerPlaceId',
              'countryCode',
              'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasAll([
              'displayName', 'address', 'active', 'deleted',
              'geocodingStatus', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.displayName is string &&
            request.resource.data.displayName.size() >= 1 &&
            request.resource.data.displayName.size() <= 80 &&
            request.resource.data.address is string &&
            request.resource.data.address.size() >= 3 &&
            request.resource.data.address.size() <= 200 &&
            request.resource.data.active is bool &&
            request.resource.data.deleted is bool &&
            request.resource.data.geocodingStatus in ['pending', 'verified'] &&
            (
              !request.resource.data.keys().hasAny(['providerPlaceId']) ||
              request.resource.data.providerPlaceId is string
            ) &&
            (
              !request.resource.data.keys().hasAny(['countryCode']) ||
              (
                request.resource.data.countryCode is string &&
                request.resource.data.countryCode.size() == 2
              )
            ) &&
            request.resource.data.updatedAt == request.time;
        }

        allow get, list: if eligibleUser() &&
          request.auth.uid == userId &&
          isBusinessAccount();
        allow create: if eligibleUser() &&
          request.auth.uid == userId &&
          isBusinessAccount() &&
          exists(/databases/$(database)/documents/businessProfiles/$(userId)) &&
          validLocation() &&
          (
            (
              !request.resource.data.keys().hasAny([
                'location', 'geohash', 'providerPlaceId'
              ]) &&
              request.resource.data.geocodingStatus == 'pending'
            ) ||
            (
              request.resource.data.geocodingStatus == 'verified' &&
              request.resource.data.location is latlng &&
              request.resource.data.geohash is string &&
              request.resource.data.providerPlaceId is string
            )
          ) &&
          request.resource.data.active == true &&
          request.resource.data.deleted == false &&
          request.resource.data.createdAt == request.time;
        allow update: if eligibleUser() &&
          request.auth.uid == userId &&
          isBusinessAccount() &&
          validLocation() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'address', 'active', 'deleted',
            'geocodingStatus', 'location', 'geohash', 'providerPlaceId',
            'countryCode', 'updatedAt'
          ]) &&
          (
            request.resource.data.address == resource.data.address ||
            request.resource.data.geocodingStatus == 'pending' ||
            (
              request.resource.data.geocodingStatus == 'verified' &&
              request.resource.data.location is latlng &&
              request.resource.data.geohash is string &&
              request.resource.data.providerPlaceId is string
            )
          ) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            request.resource.data.deleted == resource.data.deleted ||
            (
              resource.data.deleted == false &&
              request.resource.data.deleted == true &&
              request.resource.data.active == false
            )
          );
        allow delete: if false;
      }
    }

    match /nicknames/{nicknameLower} {
      allow get: if verifiedIdentity() && hasAcceptedLegal();
      allow create: if verifiedIdentity() &&
        hasAcceptedLegal() &&
        request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'nicknameLower', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid', 'nickname', 'nicknameLower', 'createdAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nicknameLower == nicknameLower &&
        validNickname(
          request.resource.data.nickname,
          request.resource.data.nicknameLower
        ) &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ) &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nickname == request.resource.data.nickname &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nicknameLower == nicknameLower;
      allow delete: if eligibleUser() &&
        resource.data.uid == request.auth.uid &&
        existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ) &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nicknameLower != nicknameLower;
      allow update, list: if false;
    }

    match /publicProfiles/{userId} {
      allow get: if eligibleUser();
      allow create: if verifiedIdentity() &&
        hasAcceptedLegal() &&
        !hasActiveBan() &&
        !deletionPending() &&
        request.auth.uid == userId &&
        validPublicProfile(userId, request.resource.data);
      allow update: if eligibleUser() &&
        request.auth.uid == userId &&
        validPublicProfile(userId, request.resource.data);
      allow list, delete: if false;
    }

    match /users/{userId} {
      allow get: if verifiedIdentity() &&
        (request.auth.uid == userId || eligibleModerator());
      allow create: if verifiedIdentity() &&
        hasAcceptedLegal() &&
        !hasActiveBan() &&
        !deletionPending() &&
        request.auth.uid == userId &&
         validProfile() &&
         existsAfter(
           /databases/$(database)/documents/publicProfiles/$(userId)
         ) &&
         validPublicProfile(
           userId,
           getAfter(
             /databases/$(database)/documents/publicProfiles/$(userId)
           ).data
         ) &&
        existsAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ) &&
        getAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ).data.uid == request.auth.uid;
      allow update: if eligibleUser() &&
        request.auth.uid == userId &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['language']) &&
            request.resource.data.language in ['cs', 'en', 'de', 'pl', 'sk', 'uk', 'vi']
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'avatarId',
                'avatarBackgroundStart',
                'avatarBackgroundEnd',
                'avatarGradientDirection'
             ]) &&
             validAvatarStyle(request.resource.data) &&
             validPublicProfile(
               userId,
               getAfter(
                 /databases/$(database)/documents/publicProfiles/$(userId)
               ).data
             )
           ) ||
           (
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['themeMode']) &&
             request.resource.data.themeMode in ['system', 'light', 'dark']
           ) ||
           (
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['showOnboardingHelp']) &&
             resource.data.showOnboardingHelp == true &&
             request.resource.data.showOnboardingHelp == false
           ) ||
           (
             validNicknameChange() &&
             validPublicProfile(
               userId,
               getAfter(
                 /databases/$(database)/documents/publicProfiles/$(userId)
               ).data
             )
           )
        );
      allow delete, list: if false;

      match /blocked/{blockedUserId} {
        allow get: if eligibleUser() && request.auth.uid == userId;
        allow list: if eligibleUser() &&
          request.auth.uid == userId &&
          limited(200);
        allow create: if eligibleUser() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.keys().hasAll(['createdAt']) &&
          request.resource.data.createdAt == request.time &&
          blockedUserId != userId;
        allow delete: if eligibleUser() && request.auth.uid == userId;
        allow update: if false;
      }

      match /following/{targetUserId} {
        allow get: if eligibleUser() && request.auth.uid == userId;
        allow list: if eligibleUser() &&
          request.auth.uid == userId && limited(200);
        allow create: if eligibleUser() &&
          request.auth.uid == userId &&
          targetUserId != userId &&
          exists(
            /databases/$(database)/documents/publicProfiles/$(targetUserId)
          ) &&
          !exists(
            /databases/$(database)/documents/users/$(userId)/blocked/$(targetUserId)
          ) &&
          request.resource.data.keys().hasOnly([
            'targetUserId', 'createdAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'targetUserId', 'createdAt'
          ]) &&
          request.resource.data.targetUserId == targetUserId &&
          request.resource.data.createdAt == request.time;
        allow delete: if eligibleUser() && request.auth.uid == userId;
        allow update: if false;
      }

      match /settings/{settingId} {
        // Individual notification preferences are readable by another signed-in
        // client only so it can omit an atomic notification write without
        // blocking the underlying interaction. Settings cannot be enumerated.
        allow get: if eligibleUser() &&
          (request.auth.uid == userId || settingId == 'notifications');
        allow list: if eligibleUser() && request.auth.uid == userId;
        allow create, update: if eligibleUser() &&
          request.auth.uid == userId &&
          settingId == 'notifications' &&
          request.resource.data.keys().hasOnly([
            'replies', 'reactions', 'privateReplies',
            'followedProfiles', 'nearbyShouts'
          ]) &&
          request.resource.data.keys().hasAll([
            'replies', 'reactions', 'privateReplies',
            'followedProfiles', 'nearbyShouts'
          ]) &&
          request.resource.data.replies is bool &&
          request.resource.data.reactions is bool &&
          request.resource.data.privateReplies is bool &&
          request.resource.data.followedProfiles is bool &&
          request.resource.data.nearbyShouts is bool;
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        function notificationEnabled(setting) {
          let settingsPath = /databases/$(database)/documents/users/$(userId)/settings/notifications;
          return !exists(settingsPath) || get(settingsPath).data.get(setting, true);
        }

        function validReactionNotification() {
          let shoutId = request.resource.data.targetShoutId;
          let shoutPath = /databases/$(database)/documents/shouts/$(shoutId);
          let reactionPath = /databases/$(database)/documents/shouts/$(shoutId)/reactions/$(request.auth.uid);
          return notificationId ==
              'reaction_' + request.resource.data.reactionType + '_' + shoutId &&
            exists(shoutPath) &&
            get(shoutPath).data.authorId == userId &&
            userId != request.auth.uid &&
            existsAfter(reactionPath) &&
            getAfter(reactionPath).data.type ==
              request.resource.data.reactionType &&
            consumedRate('interaction', 'shoutReaction_' + shoutId) &&
            request.resource.data.keys().hasOnly([
              'kind', 'actorId', 'actorNickname', 'targetShoutId',
              'targetTitle', 'reactionType', 'eventCount', 'createdAt', 'readAt'
            ]) &&
            request.resource.data.keys().hasAll([
              'kind', 'actorId', 'actorNickname', 'targetShoutId',
              'targetTitle', 'reactionType', 'eventCount', 'createdAt', 'readAt'
            ]) &&
            request.resource.data.kind == 'reaction' &&
            request.resource.data.actorId == request.auth.uid &&
            request.resource.data.actorNickname == get(
              /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
            ).data.nickname &&
            request.resource.data.reactionType in ['like', 'dislike'] &&
            notificationEnabled('reactions') &&
            commonNotificationFields('reaction', shoutId);
        }

        function validCommentNotification() {
          let shoutId = request.resource.data.targetShoutId;
          let commentId = request.resource.data.targetCommentId;
          let shoutPath = /databases/$(database)/documents/shouts/$(shoutId);
          let commentPath = /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId);
          return notificationId == 'comment_' + shoutId &&
            exists(shoutPath) && get(shoutPath).data.authorId == userId &&
            userId != request.auth.uid && existsAfter(commentPath) &&
            getAfter(commentPath).data.authorId == request.auth.uid &&
            consumedRate('comment', commentId) &&
            notificationEnabled('replies') &&
            validSocialNotificationFields('comment', shoutId, commentId, false);
        }

        function validReplyNotification() {
          let shoutId = request.resource.data.targetShoutId;
          let commentId = request.resource.data.targetCommentId;
          let commentPath = /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId);
          let parentId = request.resource.data.parentCommentId;
          let parentPath = /databases/$(database)/documents/shouts/$(shoutId)/comments/$(parentId);
          return notificationId == 'reply_' + shoutId &&
            userId != request.auth.uid && existsAfter(commentPath) &&
            getAfter(commentPath).data.authorId == request.auth.uid &&
            getAfter(commentPath).data.replyToCommentId == parentId &&
            exists(parentPath) && get(parentPath).data.authorId == userId &&
            consumedRate('comment', commentId) &&
            notificationEnabled('replies') &&
            validSocialNotificationFields('reply', shoutId, commentId, true);
        }

        function validPrivateReplyNotification() {
          let shoutId = request.resource.data.targetShoutId;
          let replyId = request.resource.data.targetPrivateReplyId;
          let replyPath = /databases/$(database)/documents/shouts/$(shoutId)/privateReplies/$(replyId);
          return notificationId == 'privateReply_' + shoutId &&
            userId != request.auth.uid && existsAfter(replyPath) &&
            getAfter(replyPath).data.authorId == request.auth.uid &&
            getAfter(replyPath).data.recipientId == userId &&
            consumedRate('privateReply', replyId) &&
            notificationEnabled('privateReplies') &&
            request.resource.data.keys().hasOnly([
              'kind', 'actorId', 'actorNickname', 'targetShoutId',
              'targetTitle', 'targetPrivateReplyId', 'eventCount',
              'createdAt', 'readAt'
            ]) && commonNotificationFields('privateReply', shoutId);
        }

        function validCommentReactionNotification() {
          let shoutId = request.resource.data.targetShoutId;
          let commentId = request.resource.data.targetCommentId;
          let commentPath = /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId);
          let reactionPath = /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId)/reactions/$(request.auth.uid);
          return notificationId ==
              'commentReaction_' + request.resource.data.reactionType + '_' +
              shoutId + '_' + commentId &&
            exists(commentPath) && get(commentPath).data.authorId == userId &&
            userId != request.auth.uid && existsAfter(reactionPath) &&
            getAfter(reactionPath).data.type == request.resource.data.reactionType &&
            consumedRate('interaction', 'commentReaction_' + shoutId + '_' + commentId) &&
            notificationEnabled('reactions') &&
            request.resource.data.keys().hasOnly([
              'kind', 'actorId', 'actorNickname', 'targetShoutId',
              'targetTitle', 'targetCommentId', 'reactionType', 'eventCount',
              'createdAt', 'readAt'
            ]) &&
            request.resource.data.targetCommentId == commentId &&
            request.resource.data.reactionType in ['like', 'dislike'] &&
            commonNotificationFields('commentReaction', shoutId);
        }

        function commonNotificationFields(kind, shoutId) {
          return request.resource.data.kind == kind &&
            request.resource.data.actorId == request.auth.uid &&
            request.resource.data.actorNickname == get(
              /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
            ).data.nickname &&
            request.resource.data.targetShoutId == shoutId &&
            request.resource.data.targetTitle == get(
              /databases/$(database)/documents/shouts/$(shoutId)
            ).data.title &&
            request.resource.data.targetTitle is string &&
            request.resource.data.targetTitle.size() <= 60 &&
            request.resource.data.eventCount is int &&
            request.resource.data.eventCount >= 1 &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.readAt == null;
        }

        function validSocialNotificationFields(kind, shoutId, commentId, reply) {
          return request.resource.data.keys().hasOnly(
              reply
                ? ['kind', 'actorId', 'actorNickname', 'targetShoutId',
                   'targetTitle', 'targetCommentId', 'parentCommentId',
                   'eventCount', 'createdAt', 'readAt']
                : ['kind', 'actorId', 'actorNickname', 'targetShoutId',
                   'targetTitle', 'targetCommentId', 'eventCount',
                   'createdAt', 'readAt']
            ) &&
            request.resource.data.targetCommentId == commentId &&
            commonNotificationFields(kind, shoutId);
        }

        function validClientNotification() {
          return request.resource.data.kind == 'reaction'
            ? validReactionNotification()
            : request.resource.data.kind == 'comment'
              ? validCommentNotification()
              : request.resource.data.kind == 'reply'
                ? validReplyNotification()
                : request.resource.data.kind == 'privateReply'
                  ? validPrivateReplyNotification()
                  : request.resource.data.kind == 'commentReaction'
                    ? validCommentReactionNotification()
                    : false;
        }

        allow get: if eligibleUser() && request.auth.uid == userId;
        allow list: if eligibleUser() &&
          request.auth.uid == userId && limited(50);
        allow create: if eligibleUser() && validClientNotification() &&
          request.resource.data.eventCount == 1;
        allow update: if eligibleUser() &&
          (
            (
              request.auth.uid == userId &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readAt']) &&
              request.resource.data.readAt == request.time
            ) ||
            (
              validClientNotification() &&
              request.resource.data.eventCount ==
                resource.data.get('eventCount', 0) + 1
            )
          );
        allow delete: if false;
      }

      match /legal/{documentId} {
        allow read: if verifiedIdentity() && request.auth.uid == userId;
        allow create: if verifiedIdentity() &&
          request.auth.uid == userId &&
          !hasActiveBan() &&
          !deletionPending() &&
          documentId == 'acceptance_2026_07_25' &&
          request.resource.data.keys().hasOnly([
            'termsVersion',
            'privacyVersion',
            'communityRulesVersion',
            'ageConfirmed',
            'acceptedAt',
            'acceptedLanguage'
          ]) &&
          request.resource.data.keys().hasAll([
            'termsVersion',
            'privacyVersion',
            'communityRulesVersion',
            'ageConfirmed',
            'acceptedAt',
            'acceptedLanguage'
          ]) &&
          request.resource.data.termsVersion == '2026-07-25' &&
          request.resource.data.privacyVersion == '2026-07-25' &&
          request.resource.data.communityRulesVersion == '2026-07-25' &&
          request.resource.data.ageConfirmed == true &&
          request.resource.data.acceptedAt == request.time &&
          request.resource.data.acceptedLanguage in ['cs', 'en', 'de', 'pl', 'sk', 'uk', 'vi'];
        allow update, delete: if false;
      }
    }

    match /rateLimits/{userId}/actions/{action} {
      allow get: if eligibleUser() && request.auth.uid == userId;
      allow create: if eligibleUser() &&
        (
          !(action in ['shout', 'comment', 'privateReply']) ||
          !hasActiveContentRestriction()
        ) &&
        request.auth.uid == userId &&
        validRateCreate(action);
      allow update: if eligibleUser() &&
        request.auth.uid == userId &&
        validRateUpdate(action);
      allow list, delete: if false;
    }

    function validApprovedReport(reportId, clearanceId) {
      let clearancePath =
        /databases/$(database)/documents/moderationClearances/$(clearanceId);
      return request.resource.data.get('resolution', '') == 'contentApproved' &&
        existsAfter(clearancePath) &&
        getAfter(clearancePath).data.moderatorId == request.auth.uid &&
        getAfter(clearancePath).data.createdAt == request.time &&
        reportId in getAfter(clearancePath).data.sourceReportIds;
    }

    function validReportUpdate(reportId, clearanceId) {
      return eligibleModerator() &&
        (
          (
            resource.data.status in ['open', 'escalated'] &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'moderatorNote', 'resolvedAt', 'resolution']) &&
            request.resource.data.status == 'resolved' &&
            request.resource.data.resolvedAt == request.time &&
            (
              !request.resource.data.keys().hasAll(['moderatorNote']) ||
              (
                request.resource.data.moderatorNote is string &&
                request.resource.data.moderatorNote.size() <= 500
              )
            ) &&
            (
              !request.resource.data.keys().hasAll(['resolution']) ||
              request.resource.data.resolution in [
                'contentApproved', 'noAction', 'contentRemoved', 'sanctioned'
              ]
            ) &&
            (
              request.resource.data.get('resolution', '') !=
                'contentApproved' ||
              validApprovedReport(reportId, clearanceId)
            )
          ) ||
          (
            resource.data.status == 'open' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status', 'assignedRole', 'escalatedAt', 'escalatedBy',
                'escalationNote'
              ]) &&
            request.resource.data.status == 'escalated' &&
            request.resource.data.assignedRole == 'seniorModerator' &&
            request.resource.data.escalatedAt == request.time &&
            request.resource.data.escalatedBy == request.auth.uid &&
            (
              !request.resource.data.keys().hasAll(['escalationNote']) ||
              (
                request.resource.data.escalationNote is string &&
                request.resource.data.escalationNote.size() <= 500
              )
            )
          )
        );
    }

    match /moderationClearances/{clearanceId} {
      allow get: if eligibleAdministrator();
      allow list: if eligibleAdministrator() && limited(50);
      allow create: if eligibleModerator() &&
        request.resource.data.keys().hasOnly([
          'targetType', 'shoutId', 'contentId', 'createdAt', 'moderatorId',
          'reason', 'sourceReportIds'
        ]) &&
        request.resource.data.keys().hasAll([
          'targetType', 'shoutId', 'contentId', 'createdAt', 'moderatorId',
          'reason', 'sourceReportIds'
        ]) &&
        request.resource.data.targetType in [
          'shout', 'comment', 'privateReply'
        ] &&
        request.resource.data.shoutId is string &&
        request.resource.data.contentId is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.moderatorId == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.sourceReportIds is list &&
        request.resource.data.sourceReportIds.size() >= 1 &&
        request.resource.data.sourceReportIds.size() <= 50 &&
        moderationScopeAllowsShout(request.resource.data.shoutId);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if eligibleUser() &&
        !exists(
          /databases/$(database)/documents/moderationClearances/$('shout_' + request.resource.data.shoutId)
        ) &&
        reportId ==
          request.auth.uid + '_' + request.resource.data.shoutId &&
        consumedRate('report', reportId) &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'shoutId', 'reason', 'createdAt', 'status'
        ]) &&
        request.resource.data.keys().hasAll([
          'reporterId', 'shoutId', 'reason', 'createdAt', 'status'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.shoutId is string &&
        exists(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)
        ) &&
        get(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)
        ).data.authorId != request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'open';
      allow get: if eligibleModerator();
      allow list: if eligibleModerator() && limited(50);
      allow update: if validReportUpdate(
        reportId,
        'shout_' + resource.data.shoutId
      );
      allow delete: if false;
    }

    match /commentReports/{reportId} {
      allow create: if eligibleUser() &&
        !exists(
          /databases/$(database)/documents/moderationClearances/$('comment_' + request.resource.data.shoutId + '_' + request.resource.data.commentId)
        ) &&
        reportId ==
          request.auth.uid + '_' +
          request.resource.data.shoutId + '_' +
          request.resource.data.commentId &&
        consumedRate('report', reportId) &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'shoutId', 'commentId', 'reason', 'createdAt', 'status'
        ]) &&
        request.resource.data.keys().hasAll([
          'reporterId', 'shoutId', 'commentId', 'reason', 'createdAt', 'status'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.shoutId is string &&
        request.resource.data.commentId is string &&
        exists(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)/comments/$(request.resource.data.commentId)
        ) &&
        get(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)/comments/$(request.resource.data.commentId)
        ).data.authorId != request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'open';
      allow get: if eligibleModerator();
      allow list: if eligibleModerator() && limited(50);
      allow update: if validReportUpdate(
        reportId,
        'comment_' + resource.data.shoutId + '_' + resource.data.commentId
      );
      allow delete: if false;
    }

    match /privateReplyReports/{reportId} {
      allow create: if eligibleUser() &&
        !exists(
          /databases/$(database)/documents/moderationClearances/$('privateReply_' + request.resource.data.shoutId + '_' + request.resource.data.privateReplyId)
        ) &&
        reportId ==
          request.auth.uid + '_' +
          request.resource.data.shoutId + '_' +
          request.resource.data.privateReplyId &&
        consumedRate('report', reportId) &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'shoutId', 'privateReplyId', 'authorId', 'text',
          'reason', 'createdAt', 'status', 'priority'
        ]) &&
        request.resource.data.keys().hasAll([
          'reporterId', 'shoutId', 'privateReplyId', 'authorId', 'text',
          'reason', 'createdAt', 'status', 'priority'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.shoutId is string &&
        request.resource.data.privateReplyId is string &&
        request.resource.data.authorId is string &&
        request.resource.data.text is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'open' &&
        request.resource.data.priority == 'high' &&
        get(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)/privateReplies/$(request.resource.data.privateReplyId)
        ).data.recipientId == request.auth.uid &&
        get(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)/privateReplies/$(request.resource.data.privateReplyId)
        ).data.authorId == request.resource.data.authorId &&
        get(
          /databases/$(database)/documents/shouts/$(request.resource.data.shoutId)/privateReplies/$(request.resource.data.privateReplyId)
        ).data.text == request.resource.data.text;
      allow get: if eligibleModerator();
      allow list: if eligibleModerator() && limited(50);
      allow update: if validReportUpdate(
        reportId,
        'privateReply_' + resource.data.shoutId + '_' +
          resource.data.privateReplyId
      );
      allow delete: if false;
    }

    match /bugReports/{reportId} {
      allow create: if eligibleUser() &&
        consumedRate('report', 'bug_' + reportId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'description', 'createdAt', 'expiresAt', 'status',
          'screenshotPath', 'screenshotContentType', 'screenshotSize'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'description', 'createdAt', 'expiresAt', 'status',
          'screenshotPath', 'screenshotContentType', 'screenshotSize'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 10 &&
        request.resource.data.description.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt >= request.time + duration.value(59, 'd') &&
        request.resource.data.expiresAt <= request.time + duration.value(61, 'd') &&
        request.resource.data.status == 'open' &&
        (
          (
            request.resource.data.screenshotPath == null &&
            request.resource.data.screenshotContentType == null &&
            request.resource.data.screenshotSize == null
          ) ||
          (
            request.resource.data.screenshotPath ==
              'bugReports/' + request.auth.uid + '/' + reportId + '/screenshot' &&
            request.resource.data.screenshotContentType in [
              'image/jpeg', 'image/png', 'image/webp'
            ] &&
            request.resource.data.screenshotSize is int &&
            request.resource.data.screenshotSize > 0 &&
            request.resource.data.screenshotSize <= 5 * 1024 * 1024
          )
        );
      allow get: if eligibleModerator();
      allow list: if eligibleModerator() && limited(50);
      allow update, delete: if false;
    }

    match /accountReports/{reportId} {
      allow create: if eligibleUser() &&
        reportId == request.auth.uid + '_' +
          request.resource.data.targetUserId &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'targetUserId', 'reason', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'reporterId', 'targetUserId', 'reason', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetUserId is string &&
        request.resource.data.targetUserId != request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 3 &&
        request.resource.data.reason.size() <= 300 &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time;
      allow get: if eligibleModerator();
      allow list: if eligibleModerator() && limited(50);
      allow update, delete: if false;
    }

    match /clientErrorLogs/{logId} {
      allow create: if eligibleUser() &&
        request.resource.data.keys().hasOnly([
          'userId', 'action', 'code', 'message', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'action', 'code', 'message', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.action.size() >= 1 &&
        request.resource.data.action.size() <= 80 &&
        request.resource.data.code is string &&
        request.resource.data.code.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt >= request.time + duration.value(59, 'd') &&
        request.resource.data.expiresAt <= request.time + duration.value(61, 'd');
      allow get: if eligibleAdministrator() &&
        resource.data.createdAt >= request.time - duration.value(60, 'd');
      allow list: if eligibleAdministrator() && limited(100) &&
        resource.data.createdAt >= request.time - duration.value(60, 'd');
      allow update, delete: if false;
    }

    match /technicalLogAccessAudits/{auditId} {
      allow create: if eligibleAdministrator() &&
        request.resource.data.keys().hasOnly([
          'userId', 'role', 'action', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId', 'role', 'action', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.role in ['administrator', 'owner'] &&
        request.resource.data.role == get(
          /databases/$(database)/documents/accountRoles/$(request.auth.uid)
        ).data.role &&
        request.resource.data.action == 'view_client_error_logs' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt >= request.time + duration.value(59, 'd') &&
        request.resource.data.expiresAt <= request.time + duration.value(61, 'd');
      allow get: if eligibleAdministrator();
      allow list: if eligibleAdministrator() && limited(100);
      allow update, delete: if false;
    }

    function validShoutCreate() {
      return request.resource.data.keys().hasOnly([
          'authorId', 'authorNickname', 'title', 'text', 'categories',
          'location', 'geohash', 'createdAt', 'expiresAt', 'status', 'likesCount',
          'dislikesCount', 'commentsCount', 'savesCount', 'avatarId',
          'avatarBackgroundStart', 'avatarBackgroundEnd',
          'avatarGradientDirection', 'businessLocationId',
          'businessAuthorFormat'
        ]) &&
        request.resource.data.keys().hasAll([
          'authorId', 'authorNickname', 'title', 'text', 'categories',
          'location', 'geohash', 'createdAt', 'expiresAt', 'status', 'likesCount',
          'dislikesCount', 'commentsCount', 'savesCount'
        ]) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorNickname is string &&
        (
          (
            !isBusinessAccount() &&
            !request.resource.data.keys().hasAny([
              'businessLocationId', 'businessAuthorFormat'
            ]) &&
            canonicalNickname(request.resource.data)
          ) ||
          validBusinessShout(request.resource.data)
        ) &&
        request.resource.data.keys().hasAll([
          'avatarId', 'avatarBackgroundStart', 'avatarBackgroundEnd',
          'avatarGradientDirection'
        ]) &&
        validAvatarStyle(request.resource.data) &&
        request.resource.data.avatarId ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.avatarId &&
        request.resource.data.avatarBackgroundStart ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.avatarBackgroundStart &&
        request.resource.data.avatarBackgroundEnd ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.avatarBackgroundEnd &&
        request.resource.data.avatarGradientDirection ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.avatarGradientDirection &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 &&
        request.resource.data.text.size() <= 220 &&
        request.resource.data.categories is list &&
        request.resource.data.categories.size() >= 1 &&
        request.resource.data.categories.size() <= 2 &&
        request.resource.data.categories.hasOnly([
          'Obecné', 'Akce', 'Sport', 'Zábava', 'Pomoc', 'Upozornění',
          'Dotaz', 'Doprava', 'Jídlo a pití', 'Kultura'
        ]) &&
        request.resource.data.location is latlng &&
        request.resource.data.geohash is string &&
        request.resource.data.geohash.size() == 7 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt >=
          request.time + duration.value(14, 'm') &&
        request.resource.data.expiresAt <= request.time +
          duration.value(isBusinessAccount() ? 2881 : 1441, 'm') &&
        request.resource.data.status == 'active' &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.dislikesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.savesCount == 0;
    }

    function validShoutReactionCounters(shoutId) {
      let reactionPath =
        /databases/$(database)/documents/shouts/$(shoutId)/reactions/$(request.auth.uid);
      let oldType = exists(reactionPath) ? get(reactionPath).data.type : '';
      let newType =
        existsAfter(reactionPath) ? getAfter(reactionPath).data.type : '';
      return consumedRate(
          'interaction',
          'shoutReaction_' + shoutId
        ) &&
        request.resource.data.likesCount ==
          resource.data.get('likesCount', 0) +
          (newType == 'like' ? 1 : 0) -
          (oldType == 'like' ? 1 : 0) &&
        request.resource.data.dislikesCount ==
          resource.data.get('dislikesCount', 0) +
          (newType == 'dislike' ? 1 : 0) -
          (oldType == 'dislike' ? 1 : 0);
    }

    function validSaveCounter(shoutId) {
      let savePath =
        /databases/$(database)/documents/shouts/$(shoutId)/saves/$(request.auth.uid);
      return consumedRate('interaction', 'save_' + shoutId) &&
        request.resource.data.savesCount ==
          resource.data.get('savesCount', 0) +
          (existsAfter(savePath) ? 1 : 0) -
          (exists(savePath) ? 1 : 0);
    }

    function validCommentCountIncrease(shoutId) {
      let ratePath =
        /databases/$(database)/documents/rateLimits/$(request.auth.uid)/actions/comment;
      let commentId = getAfter(ratePath).data.lastEventId;
      let commentPath =
        /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId);
      return consumedRate('comment', commentId) &&
        existsAfter(commentPath) &&
        getAfter(commentPath).data.createdAt == request.time &&
        getAfter(commentPath).data.authorId == request.auth.uid &&
        request.resource.data.commentsCount ==
          resource.data.get('commentsCount', 0) + 1;
    }

    function validCommentCountDecrease(shoutId) {
      let ratePath =
        /databases/$(database)/documents/rateLimits/$(request.auth.uid)/actions/delete;
      let commentId = getAfter(ratePath).data.lastEventId;
      let commentPath =
        /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId);
      return consumedRate('delete', commentId) &&
        exists(commentPath) &&
        !existsAfter(commentPath) &&
        request.resource.data.commentsCount ==
          (
            resource.data.get('commentsCount', 0) > 0
              ? resource.data.get('commentsCount', 0) - 1
              : 0
          );
    }

    function validShoutCounterUpdate(shoutId) {
      return request.resource.data.likesCount is int &&
        request.resource.data.dislikesCount is int &&
        request.resource.data.commentsCount is int &&
        request.resource.data.savesCount is int &&
        request.resource.data.likesCount >= 0 &&
        request.resource.data.dislikesCount >= 0 &&
        request.resource.data.commentsCount >= 0 &&
        request.resource.data.savesCount >= 0 &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likesCount', 'dislikesCount']) &&
            validShoutReactionCounters(shoutId)
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['savesCount']) &&
            validSaveCounter(shoutId)
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commentsCount']) &&
            (
              validCommentCountIncrease(shoutId) ||
              validCommentCountDecrease(shoutId)
            )
          )
        );
    }

    match /{path=**}/comments/{commentId} {
      allow list: if eligibleUser() && limited(50);
    }

    match /shouts/{shoutId} {
      allow get: if eligibleUser();
      allow list: if eligibleUser() && limited(50);
      allow create: if canCreateContent() &&
        consumedRate('shout', shoutId) &&
        validShoutCreate();
      allow update: if eligibleUser() &&
        (
          (
            (resource.data.authorId == request.auth.uid || isModerator()) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status']) &&
            request.resource.data.status == 'deleted'
          ) ||
          validShoutCounterUpdate(shoutId)
        );
      allow delete: if false;

      match /comments/{commentId} {
        function validCommentReactionCounters() {
          let reactionPath =
            /databases/$(database)/documents/shouts/$(shoutId)/comments/$(commentId)/reactions/$(request.auth.uid);
          let oldType =
            exists(reactionPath) ? get(reactionPath).data.type : '';
          let newType =
            existsAfter(reactionPath) ? getAfter(reactionPath).data.type : '';
          return consumedRate(
              'interaction',
              'commentReaction_' + shoutId + '_' + commentId
            ) &&
            request.resource.data.likesCount ==
              resource.data.get('likesCount', 0) +
              (newType == 'like' ? 1 : 0) -
              (oldType == 'like' ? 1 : 0) &&
            request.resource.data.dislikesCount ==
              resource.data.get('dislikesCount', 0) +
              (newType == 'dislike' ? 1 : 0) -
              (oldType == 'dislike' ? 1 : 0);
        }

        allow get: if eligibleUser();
        allow list: if eligibleUser() && limited(50);
        allow create: if canCreateContent() &&
          activeShout(shoutId) &&
          consumedRate('comment', commentId) &&
          request.resource.data.keys().hasOnly([
            'authorId', 'authorNickname', 'text', 'createdAt',
            'likesCount', 'dislikesCount', 'replyToCommentId',
            'replyToNickname'
          ]) &&
          request.resource.data.keys().hasAll([
            'authorId', 'authorNickname', 'text', 'createdAt',
            'likesCount', 'dislikesCount'
          ]) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorNickname is string &&
          canonicalNickname(request.resource.data) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 220 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.likesCount == 0 &&
          request.resource.data.dislikesCount == 0 &&
          (
            (
              !request.resource.data.keys().hasAll(['replyToCommentId']) &&
              !request.resource.data.keys().hasAll(['replyToNickname'])
            ) ||
            (
              request.resource.data.replyToCommentId is string &&
              request.resource.data.replyToNickname is string &&
              exists(
                /databases/$(database)/documents/shouts/$(shoutId)/comments/$(request.resource.data.replyToCommentId)
              ) &&
              get(
                /databases/$(database)/documents/shouts/$(shoutId)/comments/$(request.resource.data.replyToCommentId)
              ).data.authorNickname == request.resource.data.replyToNickname
            )
          ) &&
          getAfter(
            /databases/$(database)/documents/shouts/$(shoutId)
          ).data.commentsCount ==
            get(
              /databases/$(database)/documents/shouts/$(shoutId)
            ).data.get('commentsCount', 0) + 1;
        allow update: if eligibleUser() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'dislikesCount']) &&
          request.resource.data.likesCount is int &&
          request.resource.data.dislikesCount is int &&
          request.resource.data.likesCount >= 0 &&
          request.resource.data.dislikesCount >= 0 &&
          validCommentReactionCounters();
        allow delete: if eligibleUser() &&
          (resource.data.authorId == request.auth.uid || isModerator()) &&
          consumedRate('delete', commentId) &&
          getAfter(
            /databases/$(database)/documents/shouts/$(shoutId)
          ).data.commentsCount ==
            (
              get(
                /databases/$(database)/documents/shouts/$(shoutId)
              ).data.get('commentsCount', 0) > 0
                ? get(
                    /databases/$(database)/documents/shouts/$(shoutId)
                  ).data.get('commentsCount', 0) - 1
                : 0
            );

        match /reactions/{userId} {
          allow get: if eligibleUser() && userId == request.auth.uid;
          allow create, update: if eligibleUser() &&
            userId == request.auth.uid &&
            consumedRate(
              'interaction',
              'commentReaction_' + shoutId + '_' + commentId
            ) &&
            request.resource.data.keys().hasOnly(['type', 'updatedAt']) &&
            request.resource.data.keys().hasAll(['type', 'updatedAt']) &&
            request.resource.data.type in ['like', 'dislike'] &&
            request.resource.data.updatedAt == request.time;
          allow delete: if eligibleUser() &&
            userId == request.auth.uid &&
            consumedRate(
              'interaction',
              'commentReaction_' + shoutId + '_' + commentId
            );
          allow list: if false;
        }
      }

      match /privateReplies/{replyId} {
        allow get: if eligibleUser() &&
          (
            resource.data.authorId == request.auth.uid ||
            resource.data.recipientId == request.auth.uid
          );
        allow list: if eligibleUser() &&
          limited(50) &&
          (
            resource.data.authorId == request.auth.uid ||
            resource.data.recipientId == request.auth.uid
          );
        allow create: if canCreateContent() &&
          activeShout(shoutId) &&
          consumedRate('privateReply', replyId) &&
          request.resource.data.keys().hasOnly([
            'authorId', 'authorNickname', 'recipientId', 'recipientNickname',
            'participants', 'text', 'createdAt', 'targetType',
            'parentCommentId'
          ]) &&
          request.resource.data.keys().hasAll([
            'authorId', 'authorNickname', 'recipientId', 'recipientNickname',
            'participants', 'text', 'createdAt', 'targetType'
          ]) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorNickname is string &&
          canonicalNickname(request.resource.data) &&
          request.resource.data.recipientId is string &&
          request.resource.data.recipientId != request.auth.uid &&
          exists(
            /databases/$(database)/documents/users/$(request.resource.data.recipientId)
          ) &&
          request.resource.data.recipientNickname ==
            get(
              /databases/$(database)/documents/users/$(request.resource.data.recipientId)
            ).data.nickname &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == 2 &&
          request.resource.data.participants[0] == request.auth.uid &&
          request.resource.data.participants[1] ==
            request.resource.data.recipientId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 220 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.targetType in [
            'shout', 'comment', 'privateReply'
          ] &&
          (
            !request.resource.data.keys().hasAll(['parentCommentId']) ||
            (
              request.resource.data.parentCommentId is string &&
              exists(
                /databases/$(database)/documents/shouts/$(shoutId)/comments/$(request.resource.data.parentCommentId)
              )
            )
          );
        allow update: if false;
        allow delete: if eligibleUser() &&
          (resource.data.authorId == request.auth.uid || isModerator());
      }

      match /reactions/{userId} {
        allow get: if eligibleUser() && userId == request.auth.uid;
        allow create, update: if eligibleUser() &&
          userId == request.auth.uid &&
          consumedRate('interaction', 'shoutReaction_' + shoutId) &&
          request.resource.data.keys().hasOnly(['type', 'updatedAt']) &&
          request.resource.data.keys().hasAll(['type', 'updatedAt']) &&
          request.resource.data.type in ['like', 'dislike'] &&
          request.resource.data.updatedAt == request.time;
        allow delete: if eligibleUser() &&
          userId == request.auth.uid &&
          consumedRate('interaction', 'shoutReaction_' + shoutId);
        allow list: if false;
      }

      match /saves/{userId} {
        allow get: if eligibleUser() && userId == request.auth.uid;
        allow create: if eligibleUser() &&
          userId == request.auth.uid &&
          consumedRate('interaction', 'save_' + shoutId) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.keys().hasAll(['createdAt']) &&
          request.resource.data.createdAt == request.time;
        allow delete: if eligibleUser() &&
          userId == request.auth.uid &&
          consumedRate('interaction', 'save_' + shoutId);
        allow update, list: if false;
      }
    }
  }
}
