rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isModerator() {
      return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    match /moderators/{moderatorId} {
      allow get: if signedIn() && request.auth.uid == moderatorId;
      allow list, create, update, delete: if false;
    }
    match /bans/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isModerator());
      allow create, update: if isModerator() && request.resource.data.keys().hasOnly([
        'userId', 'reason', 'createdAt', 'expiresAt', 'moderatorId'
      ]) && request.resource.data.userId == userId;
      allow list, delete: if false;
    }
    match /warnings/{warningId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isModerator());
      allow create: if isModerator() && request.resource.data.keys().hasOnly([
        'userId', 'reason', 'createdAt', 'moderatorId'
      ]);
      allow list, update, delete: if false;
    }
    match /accountDeletionRequests/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isModerator());
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['userId', 'email', 'requestedAt', 'retainUntil', 'status']) &&
        request.resource.data.userId == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'pending';
      allow list, update, delete: if false;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'nickname',
          'nicknameLower',
          'createdAt',
          'nicknameChangedAt',
          'nicknameChangeCount',
          'emailVerified',
          'language',
          'avatarId'
        ]) &&
        request.resource.data.keys().hasAll([
          'nickname',
          'nicknameLower',
          'createdAt',
          'nicknameChangedAt',
          'nicknameChangeCount',
          'emailVerified',
          'language',
          'avatarId'
        ]) &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() >= 3 &&
        request.resource.data.nickname.size() <= 24 &&
        request.resource.data.nicknameLower is string &&
        request.resource.data.nicknameChangeCount == 0 &&
        request.resource.data.emailVerified == true &&
        request.resource.data.language in ['cs', 'en', 'de', 'pl'] &&
        validAvatarId(request.resource.data.avatarId);
    }

    function validAvatarId(avatarId) {
      return avatarId in [
        'fox', 'owl', 'otter', 'raccoon', 'robot', 'astronaut', 'cactus',
        'mushroom', 'moon', 'comet', 'cat', 'dragon', 'mountain',
        'lightning', 'controller', 'octopus'
      ];
    }

    function validNicknameChange(userId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nickname', 'nicknameLower', 'nicknameChangedAt', 'nicknameChangeCount']) &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() >= 3 &&
        request.resource.data.nickname.size() <= 24 &&
        request.resource.data.nicknameLower is string &&
        request.resource.data.nicknameChangedAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ) &&
        getAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ).data.uid == request.auth.uid &&
        (
          (!resource.data.keys().hasAll(['nicknameChangeCount']) &&
            request.resource.data.nicknameChangeCount == 1) ||
          (resource.data.keys().hasAll(['nicknameChangeCount']) &&
            request.resource.data.nicknameChangeCount == resource.data.nicknameChangeCount + 1)
        ) &&
        (
          !resource.data.keys().hasAll(['nicknameChangeCount']) ||
          resource.data.nicknameChangeCount == 0 ||
          request.time >= resource.data.nicknameChangedAt + duration.value(30, 'd')
        );
    }

    match /nicknames/{nicknameLower} {
      allow get: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'nicknameLower', 'createdAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nicknameLower == nicknameLower &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nicknameLower == nicknameLower;
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nicknameLower != nicknameLower;
      allow update, list: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        validProfile() &&
        existsAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ) &&
        getAfter(
          /databases/$(database)/documents/nicknames/$(request.resource.data.nicknameLower)
        ).data.uid == request.auth.uid;
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        (
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['language']) &&
            request.resource.data.language in ['cs', 'en', 'de', 'pl']) ||
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['avatarId']) &&
            validAvatarId(request.resource.data.avatarId)) ||
          validNicknameChange(userId)
        );
      allow delete, list: if false;

      match /blocked/{blockedUserId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          blockedUserId != userId;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /settings/{settingId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          settingId == 'notifications' &&
          request.resource.data.keys().hasOnly([
            'replies', 'reactions', 'nearbyShouts'
          ]) &&
          request.resource.data.keys().hasAll([
            'replies', 'reactions', 'nearbyShouts'
          ]) &&
          request.resource.data.replies is bool &&
          request.resource.data.reactions is bool &&
          request.resource.data.nearbyShouts is bool;
        allow delete: if false;
      }

      match /legal/{documentId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          documentId == 'acceptance_2026_07_25' &&
          request.resource.data.keys().hasOnly([
            'termsVersion',
            'privacyVersion',
            'communityRulesVersion',
            'ageConfirmed',
            'acceptedAt',
            'acceptedLanguage'
          ]) &&
          request.resource.data.keys().hasAll([
            'termsVersion',
            'privacyVersion',
            'communityRulesVersion',
            'ageConfirmed',
            'acceptedAt',
            'acceptedLanguage'
          ]) &&
          request.resource.data.termsVersion == '2026-07-25' &&
          request.resource.data.privacyVersion == '2026-07-25' &&
          request.resource.data.communityRulesVersion == '2026-07-25' &&
          request.resource.data.ageConfirmed == true &&
          request.resource.data.acceptedAt == request.time &&
          request.resource.data.acceptedLanguage in ['cs', 'en', 'de', 'pl'];
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'shoutId', 'reason', 'createdAt', 'status'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.shoutId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.status == 'open';
      allow read: if isModerator();
      allow update: if isModerator() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'moderatorNote', 'resolvedAt']);
      allow delete: if false;
    }

    match /commentReports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'reporterId', 'shoutId', 'commentId', 'reason', 'createdAt', 'status'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.shoutId is string &&
        request.resource.data.commentId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.status == 'open';
      allow read: if isModerator();
      allow update: if isModerator() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'moderatorNote', 'resolvedAt']);
      allow delete: if false;
    }

    // Required for collectionGroup('comments') queries used by the user's
    // comment history. The write rules remain scoped below to Shouts only.
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    match /shouts/{shoutId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorNickname is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 &&
        request.resource.data.text.size() <= 220 &&
        request.resource.data.categories is list &&
        request.resource.data.categories.size() >= 1 &&
        request.resource.data.categories.size() <= 2 &&
        request.resource.data.location is latlng &&
        request.resource.data.status == 'active' &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.dislikesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.savesCount == 0;
      allow update: if signedIn() &&
        (resource.data.authorId == request.auth.uid || isModerator()) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status == 'deleted';
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            'authorId', 'authorNickname', 'text', 'createdAt',
            'replyToCommentId', 'replyToNickname'
          ]) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorNickname is string &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 220 &&
          (!request.resource.data.keys().hasAll(['replyToCommentId']) ||
            request.resource.data.replyToCommentId is string) &&
          (!request.resource.data.keys().hasAll(['replyToNickname']) ||
            request.resource.data.replyToNickname is string);
        allow update: if false;
        allow delete: if signedIn() &&
          (resource.data.authorId == request.auth.uid || isModerator());

        match /reactions/{userId} {
          allow read: if signedIn();
          allow create, update: if signedIn() &&
            userId == request.auth.uid &&
            request.resource.data.keys().hasOnly(['type', 'updatedAt']) &&
            request.resource.data.type in ['like', 'dislike'];
          allow delete: if signedIn() && userId == request.auth.uid;
        }
      }

      match /reactions/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() &&
          userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['type', 'updatedAt']) &&
          request.resource.data.type in ['like', 'dislike'];
        allow delete: if signedIn() && userId == request.auth.uid;
      }

      match /saves/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if signedIn() && userId == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
